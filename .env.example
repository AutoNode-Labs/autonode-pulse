# AutoNode Pulse — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to version control.

PORT=3000
NODE_ENV=development

# Redis (optional — service runs without it, results won't be cached)
REDIS_URL=redis://localhost:6379

# API Key authentication (optional in dev, recommended in prod)
# Set REQUIRE_AUTH=true and provide a comma-separated list of valid keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REQUIRE_AUTH=false
API_KEYS=
