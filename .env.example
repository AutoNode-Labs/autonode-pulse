# ── AutoNode Pulse API — Environment Variables ────────────────────────────
# Copy this file to .env for local development.
# In production, inject these as platform environment variables (never commit .env).

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Production: your deployed frontend URL only.
# Local dev:  http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=https://pulse.autonode.tech

# ── Authentication (optional) ─────────────────────────────────────────────
# Set REQUIRE_AUTH=true to enforce API key checks on all audit endpoints.
# API_KEYS is a comma-separated list of valid keys.
# Authenticated callers get 60 req/min; anonymous callers get 5 req/min.
REQUIRE_AUTH=false
API_KEYS=

# ── Redis (optional) ──────────────────────────────────────────────────────
# Audit results are cached for 1 hour per URL (SHA-256 keyed).
# Without Redis the service runs without caching — all features remain functional.
# Recommended providers: Upstash (serverless), Redis Cloud, or a self-hosted instance.
REDIS_URL=redis://localhost:6379

# ── Frontend (Vercel build-time injection) ────────────────────────────────
# Vite bakes this into the JS bundle at build time — set it before `npm run build`.
# Points the React dashboard at the deployed backend API origin.
# Leave empty for local dev (falls back to http://localhost:3000 in code).
VITE_API_URL=https://api.pulse.autonode.tech
