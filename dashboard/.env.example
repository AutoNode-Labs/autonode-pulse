# ── AutoNode Pulse Dashboard — Environment Variables ─────────────────────
# Copy this file to .env for local development.
# Vite bakes VITE_* variables into the JS bundle at build time — set them
# before running `npm run build` for production deployments.

# ── Backend API base URL ──────────────────────────────────────────────────
# Leave empty to use relative URLs (/api/...).
#   - Local dev:  Vite proxy forwards to http://localhost:3000
#   - Docker:     Nginx proxy forwards to http://api:3000
#   - Production: set to your deployed API origin so the browser calls it directly
VITE_API_URL=https://api.pulse.autonode.tech
